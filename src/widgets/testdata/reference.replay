# Recorded input for the reference widgets (widgets/base.zig, `Reference`), at 800 x 600 in the
# default theme: Reset at x 8..66, Wireframe at 74..172, the exposure track at 180..725, all
# centred on y 25. One line per frame below says what it does (format: input.Replay).
# 0: rest
frame
viewport 800 600
dt 0.016
pointer 400 300
# 1: hover Reset
frame
pointer 37 25
# 2: hold it
frame
buttons left
# 3: release over it: a click
frame
buttons
# 4: press Wireframe
frame
pointer 123 25
buttons left
# 5: release: checked
frame
buttons
# 6: press the track at 75%
frame
pointer 588.75 25
buttons left
# 7: drag to 10%
frame
pointer 234.5 25
# 8: drag off the track onto Reset, still held: clamped to 0
frame
pointer 37 25
# 9: release over Reset: no click, it was not pressed there
frame
buttons
# 10: press Wireframe
frame
pointer 123 25
buttons left
# 11: release: unchecked
frame
buttons
