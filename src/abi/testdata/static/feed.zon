// src/comptime/examples.zig's feed as a static UI (lcgf-gen --static): `count` items, four on
// screen, scrolled by `scroll`, on five reserved copies.
.{
    .name = "feed",
    .state = .{
        .{ .name = "count", .u32 = 100000 },
        .{ .name = "scroll", .f32 = 0 },
    },
    .ui = .{ .col = .{ .children = .{
        .{ .virtual_list = .{ .count = "count", .scroll = "scroll", .visible = 4, .height = 12, .template = .{
            .{ .col = .{ .style = .{ .size = .{ .fill, .fit } } } },
        } } },
    } } },
}
