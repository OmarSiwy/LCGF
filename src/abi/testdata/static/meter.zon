// src/abi/ct.zig's meter as a static UI (lcgf-gen --static): formatted labels (`.text`) of
// every argument kind, and braces.
.{
    .name = "meter",
    .state = .{
        .{ .name = "name", .str = "Gain" },
        .{ .name = "level", .f32 = 0.5 },
        .{ .name = "count", .u32 = 3 },
        .{ .name = "on", .bool = true },
        .{ .name = "peak", .f32 = 0 },
    },
    .ui = .{ .col = .{
        .style = .{ .pad = .{ 6, 6, 6, 6 }, .gap = 4 },
        .children = .{
            .{ .text = .{ .format = "{}: {.1} dB", .args = .{ "name", "level" } } },
            .{ .row = .{ .style = .{ .gap = 8 }, .children = .{
                .{ .text = .{ .format = "{} clips", .args = .{"count"} } },
                .{ .text = .{ .format = "on={} {{peak {.3}}}", .args = .{ "on", "peak" } } },
            } } },
            .{ .slider = .{ .id = "level", .bind = "level", .style = .{ .size = .{ .{ .px = 60 }, .{ .px = 8 } } } } },
        },
    } },
}
