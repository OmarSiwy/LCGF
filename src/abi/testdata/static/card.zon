// src/comptime/examples.zig's card as a static UI (lcgf-gen --static).
.{
    .name = "card",
    .state = .{
        .{ .name = "heading", .str = "Battery" },
        .{ .name = "body", .str = "82%" },
    },
    .ui = .{ .col = .{
        .style = .{ .pad = .{ 12, 12, 12, 12 }, .gap = 6, .fill = .{ .rgb = .{ 30, 30, 40 } }, .radius = 8, .border = 1, .border_color = .{ .rgb = .{ 80, 80, 90 } } },
        .children = .{
            .{ .label = "heading" },
            .{ .row = .{ .style = .{ .gap = 4 }, .children = .{
                .{ .label = "body" },
                .{ .col = .{ .style = .{ .size = .{ .fill, .{ .px = 1 } } } } },
            } } },
        },
    } },
}
