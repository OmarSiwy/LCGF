// The reference widgets' toolbar (src/widgets/base.zig, `Reference(.default).spec`), written as
// a C++ or Rust program writes it. src/abi/zon.zig checks lcgf-gen's tables for it against the
// ones Zig makes at compile time.
.{
    .name = "toolbar",
    .state = .{
        .{ .name = "reset_text", .str = "Reset" },
        .{ .name = "wireframe", .bool = false },
        .{ .name = "wire_text", .str = "Wireframe" },
        .{ .name = "exposure", .f32 = 0.25 },
        .{ .name = "layer", .str = "Layer 0" },
    },
    .ui = .{ .row = .{
        .style = .{ .size = .{ .fill, .fit }, .pad = .{ 8, 8, 8, 8 }, .gap = 8, .cross = .center, .fill = .{ .theme = .panel } },
        .children = .{
            .{ .button = .{ .id = "reset", .text = "reset_text" } },
            .{ .checkbox = .{ .id = "wire", .bind = "wireframe", .text = "wire_text" } },
            .{ .slider = .{ .id = "exposure", .bind = "exposure" } },
            .{ .label = "layer" },
        },
    } },
}
