+test "opaque interiors preserve zero and subthreshold borders at fractional edges" {
+    const Scene = struct {
+        rect: [4]f32,
+        radii: [4]f32,
+        clip: [4]f32,
+        scissor: [4]u32 = .{ 0, 0, 99, 83 },
+    };
