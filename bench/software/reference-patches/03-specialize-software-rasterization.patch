+/// An opaque interior of a white solid panel with a border. The deliberately narrow
+/// gate leaves fractional physical geometry and unusual scales on the full shader.
+fn borderedInterior(q: *const Quad, img: Image, scale: f32) ?[4]u32 {
+    const V = @Vector(4, f32);
+    const zero: V = @splat(0);
+    const color: Color = @bitCast(q.fill);
+    if (@as(u32, @bitCast(q.params[0])) != 0 or img.pixels.ptr != Image.white.pixels.ptr or
+        img.width != 1 or img.height != 1 or color.a != 255 or q.opacity != 1 or
+        !std.mem.eql(f32, &q.xform, &.{ 1, 0, 0, 1, 0, 0 }) or
+        !@reduce(.And, @as(V, q.clip_radii) == zero)) return null;
+    if (scale != 1 and scale != 2 and scale != 4) return null;
+
+    const s: V = @splat(scale);
+    const rect = @as(V, q.rect) * s;
+    const radii = @as(V, q.radii) * s;
+    const border = q.border * scale;
+    const clip = @as(V, q.clip) * s;
+    const limit: V = @splat(1 << 16);
+    // Bounded comparisons reject NaNs/infinities before any float-to-int conversion.
+    if (!@reduce(.And, (@abs(rect) <= limit) & (@floor(rect) == rect)) or
+        rect[0] >= rect[2] or rect[1] >= rect[3] or
+        !@reduce(.And, (radii >= zero) & (radii <= limit) & (@floor(radii) == radii)) or
+        !(q.border >= 0.001 and border <= (1 << 16) and @floor(border) == border) or
+        !@reduce(.And, @abs(clip) <= @as(V, @splat(1 << 22)))) return null;
+
+    // Proof in physical pixels: integral edges/radii/border, scales 1/2/4 and
+    // |rect| <= 2^16 keep centers, half sizes and the interior SDF arithmetic on
+    // an exactly representable half-pixel grid (magnitudes stay below 2^18).
+    // Radius capping preserves that grid. With I = max(radius, border) + 1,
+    // every center in this inset is >= I + 0.5 from each edge. In physical units,
+    // roundedBox's logical qx/qy multiplied by scale are <= -1.5, so its sqrt
+    // term is zero. The shader's scaled dist <= -I - 0.5 and dist + border * scale
+    // <= -1.5. Both shape and inner coverage saturate to exactly 1.
+    // ceil(clip.low)/floor(clip.high) conservatively put centers inside the hard
+    // clip. White texture, opaque fill, opacity 1 and no rounded clip then make
+    // source-over exactly the packed fill, regardless of the border/destination alpha.
+    const inset = @max(@reduce(.Max, radii), border) + 1;
+    const center: [4]f32 = .{
+        @max(rect[0] + inset, @ceil(clip[0])),
+        @max(rect[1] + inset, @ceil(clip[1])),
+        @min(rect[2] - inset, @floor(clip[2])),
+        @min(rect[3] - inset, @floor(clip[3])),
+    };
+    if (center[0] >= center[2] or center[1] >= center[3]) return null;
+    const pixels = toPixels(center);
+    if (pixels[0] == pixels[2] or pixels[1] == pixels[3]) return null;
+    return pixels;
+}
