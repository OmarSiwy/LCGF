.{
    .name = "volume",
    .state = .{
        .{ .name = "muted", .bool = false },
        .{ .name = "title", .str = "" },
        .{ .name = "volume", .f32 = 0.5 },
        .{ .name = "pan", .f32 = 0 },
    },
    .ui = .{ .col = .{ .style = .{
        .size = .{ .fill, .fill },
        .pad = .{ 4, 4, 4, 4 },
        .gap = 4,
        .fill = .{ .rgba = .{ 30, 31, 36, 255 } },
    }, .children = .{
        .{ .row = .{ .style = .{ .gap = 8 }, .children = .{ .{ .checkbox = .{
            .id = "mute",
            .bind = "muted",
            .style = .{ .size = .{ .{ .px = 16 }, .{ .px = 16 } }, .fill = .{ .rgba = .{ 200, 200, 200, 255 } } },
        } }, .{ .label = "title" } } } },
        .{ .slider = .{
            .id = "volume",
            .bind = "volume",
            .style = .{ .size = .{ .{ .pct = 1 }, .{ .px = 12 } }, .fill = .{ .rgba = .{ 90, 90, 90, 255 } } },
        } },
        .{ .slider = .{
            .id = "pan",
            .bind = "pan",
            .style = .{ .size = .{ .{ .px = 100 }, .{ .px = 10 } }, .fill = .{ .rgba = .{ 90, 90, 90, 255 } } },
        } },
    } } },
}
