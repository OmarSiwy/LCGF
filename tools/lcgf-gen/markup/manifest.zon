        .{ .kind = "element", .name = "section", .status = .mapped, .target = "spec.landmark(.region) when named, else col", .fixture = "landmarks" },
        .{ .kind = "element", .name = "form", .status = .mapped, .target = "spec.landmark(.form)", .fixture = "landmarks" },
        .{ .kind = "element", .name = "search", .status = .mapped, .target = "spec.landmark(.search)", .fixture = "landmarks" },
