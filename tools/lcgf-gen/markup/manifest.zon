// The HTML/CSS mapping manifest (manifest.zig): one row per decision. `lcgf-gen --mappings`
// prints it as TSV. Statuses: mapped (lowered onto today's framework; `fixture` shows it),
// pending (lowered onto engine API specified in docs/plans/markup-engine-api.md, entry
// `spec`), planned (not lowered by the compiler yet), rejected (not modelled by design).
.{
    .rows = .{
        // ---- document and metadata
        .{ .kind = "element", .name = "!doctype", .status = .rejected, .diagnostic = "use <!doctype html>; quirks mode is not supported" },
        .{ .kind = "element", .name = "html", .status = .mapped, .target = "page name (lcgf-page)", .fixture = "hello" },
        .{ .kind = "element", .name = "head", .status = .mapped, .target = "no node", .fixture = "hello" },
        .{ .kind = "element", .name = "title", .status = .mapped, .target = "pub const title", .fixture = "hello" },
        .{ .kind = "element", .name = "meta", .status = .mapped, .target = "charset must be UTF-8; others ignored", .fixture = "hello" },
        .{ .kind = "element", .name = "link", .applies_to = "rel=stylesheet", .status = .mapped, .target = "CSS input, depfile entry", .fixture = "counter" },
        .{ .kind = "element", .name = "style", .status = .mapped, .target = "CSS input in document order", .fixture = "landmarks" },
        .{ .kind = "element", .name = "script", .status = .rejected, .diagnostic = "no JavaScript: behaviour is code in your app; name a handler with on:click=\"save\"" },
        .{ .kind = "element", .name = "noscript", .status = .mapped, .target = "children ignored", .fixture = "hello" },
        .{ .kind = "element", .name = "body", .status = .mapped, .target = "spec.col spec.zig:90, size .fill both axes, fill Theme.panel (ua.css)", .fixture = "hello" },
        .{ .kind = "element", .name = "base", .status = .rejected, .diagnostic = "<base> is not supported; write paths relative to the page" },
        .{ .kind = "value", .name = "remote-url", .status = .rejected, .diagnostic = "remote stylesheets and images are not fetched; vendor the file" },

        // ---- sectioning and grouping
        .{ .kind = "element", .name = "div", .status = .mapped, .target = "spec.col/row spec.zig:90/97; text-only content: widgets_label.ct.label", .fixture = "counter" },
        .{ .kind = "element", .name = "main", .status = .mapped, .target = "spec.landmark(.main) spec.zig:115", .fixture = "landmarks" },
        .{ .kind = "element", .name = "nav", .status = .mapped, .target = "spec.landmark(.navigation)", .fixture = "landmarks" },
        .{ .kind = "element", .name = "header", .status = .mapped, .target = "spec.landmark(.banner) outside article/aside/main/nav/section, else col", .fixture = "landmarks" },
        .{ .kind = "element", .name = "footer", .status = .mapped, .target = "spec.landmark(.content_info), same ancestry rule", .fixture = "landmarks" },
        .{ .kind = "element", .name = "aside", .status = .mapped, .target = "spec.landmark(.complementary)", .fixture = "landmarks" },
        .{ .kind = "element", .name = "article", .status = .mapped, .target = "spec.landmark(.article)", .fixture = "landmarks" },
        .{ .kind = "element", .name = "section", .status = .mapped, .target = "spec.landmark(.region) when named, else col", .fixture = "landmarks" },
        .{ .kind = "element", .name = "form", .status = .mapped, .target = "spec.landmark(.form)", .fixture = "landmarks" },
        .{ .kind = "element", .name = "search", .status = .mapped, .target = "spec.landmark(.search)", .fixture = "landmarks" },
        .{ .kind = "element", .name = "h1", .status = .mapped, .target = "spec.heading(1, …) spec.zig:123 + spec.textStyled (UA 2em)", .fixture = "hello" },
        .{ .kind = "element", .name = "h2", .status = .mapped, .target = "spec.heading(2, …), UA 1.5em", .fixture = "landmarks" },
        .{ .kind = "element", .name = "p", .status = .mapped, .target = "widgets_label.ct.label + text_style.wrap (UA white-space: normal)", .fixture = "hello" },
        .{ .kind = "feature", .name = "inline-runs", .applies_to = "p", .status = .mapped, .target = "one label in style runs (spec.spans, protocol.Span: size, colour, font per run) over span, strong, em, b, i, code and the other phrasing elements; MonoParagraphs", .fixture = "inline" },
        .{ .kind = "element", .name = "span", .status = .mapped, .target = "widgets_label.ct.label", .fixture = "counter" },
        .{ .kind = "element", .name = "br", .status = .mapped, .target = "\\n in the label's literal", .fixture = "hello" },
        .{ .kind = "element", .name = "hr", .status = .mapped, .target = "widgets_separator.ct.separator w/separator:52, orientation from the parent axis", .fixture = "landmarks" },
        .{ .kind = "element", .name = "pre", .status = .mapped, .target = "label with white-space kept", .fixture = "hello" },

        // ---- media: not modelled
        .{ .kind = "element", .name = "iframe", .status = .rejected, .diagnostic = "<iframe> embeds a browsing context, which LCGF does not provide" },
        .{ .kind = "element", .name = "object", .status = .rejected, .diagnostic = "<object> embeds a plug-in, which LCGF does not provide" },
        .{ .kind = "element", .name = "embed", .status = .rejected, .diagnostic = "<embed> embeds a plug-in, which LCGF does not provide" },
        .{ .kind = "element", .name = "audio", .status = .rejected, .diagnostic = "<audio> needs a media host, which LCGF does not provide" },
        .{ .kind = "element", .name = "video", .status = .rejected, .diagnostic = "<video> needs a media host, which LCGF does not provide" },
        .{ .kind = "element", .name = "track", .status = .rejected, .diagnostic = "<track> needs a media host, which LCGF does not provide" },
        .{ .kind = "element", .name = "source", .status = .rejected, .diagnostic = "<source> needs a media host, which LCGF does not provide" },
        .{ .kind = "element", .name = "picture", .status = .rejected, .diagnostic = "<picture> selects media at run time; use one <img>" },
        .{ .kind = "element", .name = "map", .status = .rejected, .diagnostic = "image maps are not modelled; use buttons" },
        .{ .kind = "element", .name = "area", .status = .rejected, .diagnostic = "image maps are not modelled; use buttons" },
        .{ .kind = "element", .name = "math", .status = .rejected, .diagnostic = "MathML is not modelled; render the formula to an image" },

        // ---- form controls
        .{ .kind = "element", .name = "button", .status = .mapped, .target = "widgets_button.ct.button w/button:71", .fixture = "counter" },
        .{ .kind = "element", .name = "button", .applies_to = "aria-pressed", .status = .mapped, .target = "widgets_toggle.ct.toggle w/toggle:82, bool", .fixture = "settings" },
        .{ .kind = "element", .name = "input", .applies_to = "type=checkbox", .status = .mapped, .target = "widgets_checkbox.ct.checkbox w/checkbox:126, bool", .fixture = "mixer" },
        .{ .kind = "element", .name = "input", .applies_to = "type=checkbox switch", .status = .mapped, .target = "widgets_switch.ct.switch w/switch:97, bool", .fixture = "settings" },
        .{ .kind = "element", .name = "input", .applies_to = "type=range", .status = .mapped, .target = "widgets_slider.ct.slider w/slider:130, f32 over Range{lo,hi}", .fixture = "mixer" },
        .{ .kind = "element", .name = "input", .applies_to = "type=button", .status = .mapped, .target = "widgets_button.ct.button", .fixture = "settings" },
        .{ .kind = "element", .name = "input", .applies_to = "type=hidden", .status = .mapped, .target = "no node", .fixture = "settings" },
        .{ .kind = "element", .name = "input", .applies_to = "type=number", .status = .mapped, .target = "widgets_number.ct.number w/number:197, Number over Range{lo,hi,step}", .fixture = "controls" },
        .{ .kind = "element", .name = "input", .applies_to = "type=radio", .status = .mapped, .target = "widgets_radio.ct.radio w/radio:161, one group per name, u32 index", .fixture = "controls" },
        .{ .kind = "attribute", .name = "bind:selected", .status = .mapped, .target = "a radio group's u32 field", .fixture = "controls" },
        .{ .kind = "element", .name = "fieldset", .status = .mapped, .target = "spec.col (legend and group box: card.ct.card, planned)", .fixture = "controls" },
        .{ .kind = "element", .name = "input", .applies_to = "type=text", .status = .mapped, .target = "widgets_textfield.ct.textfield(theme, .id, .field, \"hint\"), Text(256)", .fixture = "form" },
        .{ .kind = "element", .name = "input", .applies_to = "type=search", .status = .mapped, .target = "widgets_search.ct.search(theme, .id, .field, \"hint\")", .fixture = "form" },
        .{ .kind = "element", .name = "textarea", .status = .mapped, .target = "widgets_textarea.ct.textarea(theme, .id, .field, rows, \"hint\")", .fixture = "form" },
        .{ .kind = "attribute", .name = "placeholder", .status = .mapped, .target = "the text control's hint", .fixture = "form" },
        .{ .kind = "element", .name = "input", .applies_to = "type=password", .status = .mapped, .target = "widgets_textfield.ct.password / password: one mask per grapheme (Editor.Mode.password), never copied, secure text input", .fixture = "form" },
        .{ .kind = "element", .name = "select", .status = .mapped, .target = "widgets_select.ct.select(theme, .id, .field, .{ .texts, .groups }) in the flow and ct.list last in a root over the viewport (F10); bind:value is a SelectState, its .selected the value; runtime: select.button and select.listGrouped; CSS on the <select> restyles its button (spec.styled; runtime select.buttonFace)", .fixture = "overlays" },
        .{ .kind = "element", .name = "option", .status = .mapped, .target = "one caption of its <select> (its label or text); selected makes it the default. CSS on the <option>s lays out every row and draws its text (Options.option and .option_text; runtime select.listFace), the same for every option of a select; background-color fills a row neither highlighted nor chosen; margins, box-shadow, outline and multi-line text are an error", .fixture = "overlays" },
        .{ .kind = "element", .name = "optgroup", .status = .mapped, .target = "a header (its label) before its first option, which the keys and the pointer pass over", .fixture = "overlays" },
        .{ .kind = "attribute", .name = "bind:value", .applies_to = "select", .status = .mapped, .target = "a widgets_select.SelectState field; on:change gets .selected as a u32", .fixture = "overlays" },
        .{ .kind = "attribute", .name = "popover", .status = .mapped, .target = "an element with an id: widgets_popover.ct.popover(theme, .id, .open, .{ content }) last in the root, over its bind:open or a generated bool <id>_open; light dismiss (a press outside, Escape); runtime: popover.begin/end", .fixture = "overlays" },
        .{ .kind = "element", .name = "menu", .applies_to = "popover", .status = .mapped, .target = "<menu id popover> of <button>s (in <li>s or not), opened by its <button popovertarget>: widgets_menu.ct.button in the flow and ct.list last in the root over a MenuState field <id>_menu; an item's on:click runs when it is chosen (click, or arrows and Enter); runtime: menu.trigger/show", .fixture = "overlays" },
        .{ .kind = "attribute", .name = "popovertarget", .applies_to = "button", .status = .mapped, .target = "widgets_popover.ct.button(theme, .id, .open, caption): the button named by its popover, which hangs below it; no id or on:click of its own; runtime: popover.trigger", .fixture = "overlays" },
        .{ .kind = "attribute", .name = "title", .status = .mapped, .target = "on a widget with an id: its tooltip, widgets_tooltip.ct.tooltip(theme, .id, .id_tip, text) last in the root over a Tip field <id>_tip (shown after tooltip.delay of hover, Escape hides); runtime: tooltip.update/show; elsewhere an error", .fixture = "overlays" },
        .{ .kind = "element", .name = "dialog", .status = .mapped, .target = "widgets_dialog.ct.dialog(theme, .id, .open, .{ content }), or ct.dialogFace with CSS on the <dialog> as its panel's style (runtime dialog.beginFace; margins, box-shadow and outline an error; dialog::backdrop's background-color fills its backdrop) last in a root over the viewport (F10): modal, Escape closes, Tab stays inside; runtime: dialog.begin/end", .fixture = "overlays" },
        .{ .kind = "attribute", .name = "bind:open", .applies_to = "dialog", .status = .mapped, .target = "the dialog's bool field: shown while true; Escape sets it false; the open attribute makes it start true", .fixture = "overlays" },
        .{ .kind = "element", .name = "a", .status = .mapped, .target = "with href: widgets_link.ct.link(theme, .id, text) w/link:67, activated by click and Enter; on:click gets it, the href is not followed. Without href: text", .fixture = "content", .spec = "F4" },
        .{ .kind = "element", .name = "ul", .status = .mapped, .target = "spec.col with Style.role = .list (types.Role, F1); UA list-style-type: disc", .fixture = "content", .spec = "F1" },
        .{ .kind = "element", .name = "ol", .status = .mapped, .target = "spec.col with Style.role = .list; UA list-style-type: decimal from start, down from it (default the item count) under reversed", .fixture = "content", .spec = "F1" },
        .{ .kind = "element", .name = "menu", .status = .mapped, .target = "spec.col with Style.role = .list, as <ul>", .fixture = "content", .spec = "F1" },
        .{ .kind = "element", .name = "li", .status = .mapped, .target = "with a marker: a row with Style.role = .list_item (its box) holding the marker label and its content filling the rest; list-style-type: none keeps the plain box with the role", .fixture = "content", .spec = "F1" },
        .{ .kind = "property", .name = "list-style-type", .status = .mapped, .target = "inherited marker label: disc, circle, square, disclosure-open/-closed, a string as written, or a counter style (decimal, decimal-leading-zero, lower/upper-alpha, -latin, -roman, lower-greek) of the item's place among its siblings from the list's start, formatted at build time by text_counters, or inside lcgf-each=\"x in xs\" at run time from the copy index (an lcgf-max list's shared template an error); none; list-style sets it", .fixture = "content" },
        .{ .kind = "element", .name = "table", .status = .mapped, .target = "spec.grid: one fit column per cell of the widest row, one row per <tr>; role table; static rows", .fixture = "table" },
        .{ .kind = "element", .name = "tr", .status = .mapped, .target = "spec.cell at (0, row) across the columns, and spec.grid with Decl.subgrid on x; role row", .fixture = "table" },
        .{ .kind = "element", .name = "td", .status = .mapped, .target = "a grid item of its row, role cell; colspan -> Item.span[0]; with a rowspan in the table, each cell at its slot from the HTML table algorithm and each row a subgrid on both axes over the rows its cells reach", .fixture = "table" },
        .{ .kind = "element", .name = "th", .status = .mapped, .target = "as td, role column_header (row_header with scope=row)", .fixture = "table" },
        .{ .kind = "element", .name = "thead", .status = .mapped, .target = "its rows go to the table (tbody, tfoot alike)", .fixture = "table" },
        .{ .kind = "element", .name = "caption", .status = .mapped, .target = "a grid item across the table's columns in the first row (caption-side: bottom, the last); its text names the table", .fixture = "table" },
        .{ .kind = "element", .name = "colgroup", .status = .mapped, .target = "span columns of its width (px -> Track.px, else fit); a <col> inside without a width takes it", .fixture = "table" },
        .{ .kind = "element", .name = "col", .status = .mapped, .target = "span columns of its width: px -> Track.px, auto -> fit; % and background are errors", .fixture = "table" },
        .{ .kind = "element", .name = "img", .status = .mapped, .target = "widgets_image.ct.image(theme, assets[k].picture(), .{ .box, .fit, .radius }): a local PNG decoded, or SVG drawn by draw/svg.zig at its shown size, by lcgf-gen into the page's asset table (asset k is texture k + 1, uploaded by the app); width/height (CSS px, else the attributes; one side keeps the shape); alt names it, alt=\"\" decorates; remote src and other formats are errors", .fixture = "images" },
        .{ .kind = "property", .name = "object-fit", .status = .mapped, .target = "image.Options.fit: fill (default) -> stretch, contain, cover; none and scale-down are errors", .fixture = "images" },
        .{ .kind = "element", .name = "details", .status = .mapped, .target = "widgets_accordion.ct.section(theme, .id, .open, summary, content) w/accordion:119; runtime accordion.open/close; CSS on the <details> lays out the section and on its <summary> the header (ct.sectionFace, runtime accordion.openFace)", .fixture = "content" },
        .{ .kind = "element", .name = "summary", .status = .mapped, .target = "the first child of <details>: the section header's one literal or field", .fixture = "content" },
        .{ .kind = "attribute", .name = "bind:open", .applies_to = "details", .status = .mapped, .target = "the section's expanded bool; the open attribute makes it start true", .fixture = "content" },
        .{ .kind = "element", .name = "progress", .status = .mapped, .target = "widgets_progress.ct.progress w/progress:92, f32 0..1", .fixture = "mixer" },
        .{ .kind = "element", .name = "label", .status = .mapped, .target = "the wrapped or for= control's caption; on a control that draws none (text, search, textarea, number, range, progress), its accessible name", .fixture = "mixer" },
        .{ .kind = "element", .name = "x-name", .status = .mapped, .target = "app component (plan §3.4): app.components.@\"x-name\"(theme, .{ .prop = … }) returning a Spec; literal props are strings, {f} is .f, var(--t-x) is the token field \"x\" (spec.tokened, fixture themed), content is the prop children: []const Spec; id and on:click name its widget; checked at the HTML (checkComponents); runtime frontend: the runtime form, as in an lcgf-each item, with {f} the field's value and var(--t-x) the token's", .fixture = "components" },
        .{ .kind = "element", .name = "x-name", .applies_to = "lcgf-each item", .status = .mapped, .target = "the runtime form (a plain fn, or the namespace's frame beside its spec) app.components.@\"x-name\"(f, &theme, .{ .id = Id.with(index), .prop = item.f }) once per item; on:click reads its Response.clicked and gets the index; with content, the namespace's open(f, &theme, props) before it and close(f, &theme) after", .fixture = "components" },
        .{ .kind = "attribute", .name = "type", .applies_to = "file", .status = .rejected, .diagnostic = "file selection needs a host file picker; open one from a button's handler" },
        .{ .kind = "attribute", .name = "type", .applies_to = "image", .status = .rejected, .diagnostic = "<input type=image> submits pixel coordinates, which are not modelled; use a button" },

        // ---- attributes
        .{ .kind = "attribute", .name = "id", .status = .mapped, .target = "widget id: Events(spec).Widget tag; selector key", .fixture = "counter" },
        .{ .kind = "attribute", .name = "class", .status = .mapped, .target = "cascade", .fixture = "counter" },
        .{ .kind = "attribute", .name = "style", .status = .mapped, .target = "cascade, inline origin", .fixture = "landmarks" },
        .{ .kind = "attribute", .name = "hidden", .status = .mapped, .target = "node not emitted", .fixture = "landmarks" },
        .{ .kind = "attribute", .name = "aria-labelledby", .status = .mapped, .target = "the accessible name: the referenced elements' literal text, joined by spaces, read at build time (as aria-label)", .fixture = "landmarks" },
        .{ .kind = "attribute", .name = "aria-label", .status = .mapped, .target = "spec.named, exported by ComptimeUi.semantics; runtime: Ui.named rows and Ui.semantics(t, s, str) (Semantics.label)", .fixture = "landmarks" },
        .{ .kind = "attribute", .name = "on*", .status = .rejected, .diagnostic = "script attributes are not run; write on:click=\"save\"" },
        .{ .kind = "attribute", .name = "tabindex", .applies_to = "positive", .status = .rejected, .diagnostic = "positive tabindex is not supported; reorder the markup" },
        .{ .kind = "attribute", .name = "contenteditable", .status = .rejected, .diagnostic = "rich editing is not supported; use <textarea>" },
        .{ .kind = "attribute", .name = "on:click", .status = .mapped, .target = "Page(H).frame: ComptimeUi Output.event base.zig:436 -> h.name(ui)", .fixture = "counter" },
        .{ .kind = "attribute", .name = "on:change", .status = .mapped, .target = "Page(H).frame: field compare after the frame -> h.name(ui, value)", .fixture = "mixer" },
        .{ .kind = "attribute", .name = "on:submit", .applies_to = "text controls", .status = .mapped, .target = "Enter in a text or search field, Ctrl+Enter (Cmd+Enter) in a textarea: the control's Result.submitted -> h.name(ui)", .fixture = "form" },
        .{ .kind = "attribute", .name = "bind:checked", .status = .mapped, .target = "the builder's bind field, bool", .fixture = "mixer" },
        .{ .kind = "attribute", .name = "bind:value", .status = .mapped, .target = "the builder's bind field, f32 for range", .fixture = "mixer" },
        .{ .kind = "event", .name = "dblclick", .status = .rejected, .diagnostic = "use an app component for pointer-level input" },
        .{ .kind = "event", .name = "contextmenu", .status = .rejected, .diagnostic = "use an app component for pointer-level input" },
        .{ .kind = "event", .name = "wheel", .status = .rejected, .diagnostic = "use an app component for pointer-level input" },
        .{ .kind = "event", .name = "pointermove", .status = .rejected, .diagnostic = "use an app component for pointer-level input" },

        // ---- frontends (§1.4)
        .{ .kind = "attribute", .name = "lcgf-frontend", .applies_to = "html", .status = .mapped, .target = "spec (ComptimeUi) or runtime (Ui.build over Frame and the widgets' runtime functions); --frontend overrides", .fixture = "runtime" },
        .{ .kind = "feature", .name = "runtime-widget-face", .status = .mapped, .target = "runtime: CSS on a button, link, toggle, checkbox, switch, slider, text field, password, search field, number field, textarea, progress bar, separator or radio group is <widget>Face(…, style), its root laid out by the style as spec.styled lays out the comptime widget's (engine spec R1)", .fixture = "faces" },
        .{ .kind = "feature", .name = "runtime-widget-style", .status = .planned, .diagnostic = "runtime frontend: CSS on this widget needs a runtime widget function that takes a style (engine spec R1)", .spec = "R1" },

        // ---- regions (§3.5)
        .{ .kind = "attribute", .name = "lcgf-if", .applies_to = "template", .status = .mapped, .target = "spec.when spec.zig:273, bool", .fixture = "todo" },
        .{ .kind = "attribute", .name = "lcgf-each", .applies_to = "template", .status = .mapped, .target = "spec.list(.n, lcgf-max, style, template) spec.zig:245, u32", .fixture = "todo" },
        .{ .kind = "attribute", .name = "lcgf-switch", .applies_to = "template", .status = .mapped, .target = "spec.choice spec.zig:286 over a generated enum of the lcgf-case names", .fixture = "todo" },
        .{ .kind = "attribute", .name = "lcgf-case", .applies_to = "template", .status = .mapped, .target = "one alternative of spec.choice", .fixture = "todo" },
        .{ .kind = "attribute", .name = "lcgf-else", .applies_to = "template", .status = .mapped, .target = "with the lcgf-if before it: spec.choice(.f, .{}, .{ otherwise, then }) over the bool (T4); runtime: switch (f) { false, true }", .fixture = "todo" },
        .{ .kind = "attribute", .name = "on:change", .applies_to = "text control", .status = .mapped, .target = "the widget's event: if (result.changed) h.name(ui, text: []const u8), beside on:submit's result.submitted", .fixture = "form" },
        .{ .kind = "attribute", .name = "on:change", .applies_to = "lcgf-each item", .status = .mapped, .target = "h.name(ui, index, value) after the frame; with checked=\"{item.f}\" or value=\"{item.f}\" the control is one-way and the item (a const slice is fine) is not written", .fixture = "intents" },
